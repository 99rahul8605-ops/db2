BOT_TOKEN=PUT_BOT_TOKEN_HERE
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=put_api_hash_here
ADMIN_IDS=123456789

UPLOAD_DIR=./uploads
EXTRACT_DIR=./extracted
STATE_DB=./queue.db
SESSION_DIR=./session
KEYS_DB=./api_keys.db
LOOKUP_DB=./lookup/users_lookup.db
ZIP_PATH=./extracted/users_data.zip
ZIP_MEMBER=users_data.json

PARALLEL_STREAMS=4
PROGRESS_INTERVAL=3
STREAM_RETRIES=12
STREAM_RETRY_DELAY=2
MAX_LOOKUP_RESULTS=10

API_HOST=127.0.0.1
API_PORT=8080
IMPORT_BATCH_SIZE=10000
IMPORT_COMMIT_EVERY=50000

# Optional: set if public-IP auto detection is wrong (example: 203.0.113.10)
PUBLIC_HOST=
RATE_LIMIT_PER_MIN=60

# Optional HTTPS hostname for Cloudflare Tunnel (tunnel must be running)
PUBLIC_API_URL=https://dbapi.teamsecret.in
# Optional custom cloudflared YAML location; never store tunnel token in source
TUNNEL_CONFIG=/root/.cloudflared/db2-api.yml

# IMPORTANT: use a SEPARATE BotFather bot token from your upload bot.
MANAGER_BOT_TOKEN=PUT_NEW_MANAGER_BOT_TOKEN_HERE
ADMIN_IDS=123456789

ZIP_PATH=/root/db2/extracted/users_data.zip
ZIP_MEMBER=users_data.json
DB_PATH=/root/db2/lookup/users_lookup.db
KEYS_DB_PATH=/root/db2/lookup/api_keys.db

BIND_HOST=127.0.0.1
BIND_PORT=8080
MAX_RESULTS=10
SHOW_FULL_FIELDS=1
ALLOW_LOOKUP_DURING_IMPORT=0
API_RATE_LIMIT_PER_MINUTE=120

IMPORT_BATCH_SIZE=10000
IMPORT_COMMIT_EVERY=100000

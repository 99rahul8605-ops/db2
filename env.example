# BotFather token
BOT_TOKEN=123456789:PUT_BOT_TOKEN_HERE

# Get from https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=put_api_hash_here

# Your Telegram numeric user ID. Multiple IDs comma-separated.
ADMIN_IDS=123456789

# Ubuntu paths
BASE_DIR=/opt/hitek-bot
UPLOAD_DIR=/opt/hitek-bot/uploads
EXTRACT_DIR=/opt/hitek-bot/extracted
STATE_DB=/opt/hitek-bot/queue.db
SESSION_DIR=/opt/hitek-bot/session

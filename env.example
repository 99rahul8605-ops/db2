BOT_TOKEN=PUT_BOT_TOKEN_HERE
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=put_api_hash_here
ADMIN_IDS=123456789

# Optional paths; defaults below are relative to this repo.
UPLOAD_DIR=./uploads
EXTRACT_DIR=./extracted
STATE_DB=./queue.db
SESSION_DIR=./session

# One queue file at a time; that active file uses this many Telegram range workers.
# Recommended: 4. If Telegram throttles or network gets unstable, try 2.
PARALLEL_STREAMS=4
PROGRESS_INTERVAL=3
